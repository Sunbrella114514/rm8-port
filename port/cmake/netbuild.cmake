# [N] netplay build hash (app/net.cpp HELLO, docs/netplay.md section 4.2): SHA-256 over the names and contents of the app sources and the build
# description, so a PC build and an Android build of the same tree agree and different trees refuse to play together (their simulations may differ).
# usage: cmake -DSRC_DIR=<port> -DOUT=<header> -P netbuild.cmake
file(GLOB files ${SRC_DIR}/app/*.cpp ${SRC_DIR}/app/*.h ${SRC_DIR}/app/*.inc)
list(APPEND files ${SRC_DIR}/CMakeLists.txt ${SRC_DIR}/cmake/py24.cmake)
list(SORT files)
set(acc "")
foreach(f ${files})
  file(READ ${f} content HEX)
  string(SHA256 h "${content}")
  get_filename_component(n ${f} NAME)
  string(APPEND acc "${n}:${h};")
endforeach()
string(SHA256 all "${acc}")
string(SUBSTRING ${all} 0 16 short)
file(WRITE ${OUT}.tmp "// generated by cmake/netbuild.cmake: the netplay build hash of the app sources\n#define RM8_NET_BUILD \"${short}\"\n")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
