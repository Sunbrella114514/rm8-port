# Publish whitelist: ignore everything, allow only what PUBLISH.md lists.
# Reverse-engineering artefacts (mod/, out/, ghidra_proj/, scripts/, decompiled code, screenshots, original-text docs) stay on the
# developer machine and are NOT published.  Build the publish tree with extractor/tools/make_publish_tree.py.
/*
!/.gitignore
!/LICENSE
!/NOTICE.md
!/THIRD_PARTY_NOTICES.md
!/README.md
!/PUBLISH.md
!/port/
!/extractor/
# the de-quoted documentation (generated by make_publish_tree.py --docs-only docs_public); the original docs/ is private
!/docs_public/
!/docs/

# never, anywhere
*.apk
*.idsig
*.exe
*.dll
*.dat
*.bik
*.mpg
*.keystore
__pycache__/
*.pyc
rm8_gamedate.bin
rm8_box.bin
rm8_settings.txt
extract.log
/manifest.json
